{
  "manifest_version": 3,
  "name": "Kokoro Reader — Local AI Read Aloud",
  "short_name": "Kokoro Reader",
  "version": "1.0.2",
  "description": "Read any web page aloud with the Kokoro-82M neural voice. Runs 100% on your device (WebGPU or WASM) — no cloud, no account.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kokoro Reader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["offscreen", "storage", "contextMenus", "scripting", "activeTab", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "read-page-or-toggle": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read page aloud / play–pause"
    },
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Read selected text"
    },
    "pick-element": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Pick a page element to read"
    },
    "stop": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Stop reading"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
